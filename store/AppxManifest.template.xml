<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifeste du paquet Microsoft Store de Pesée.
  Les valeurs entre accolades sont remplacées par build-store.ps1 :
    {IdentityName} {Publisher} {PublisherDisplayName}  -> fournies par Partner Center (Identité du produit)
    {Version} {Arch}
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop4 desktop5 com rescap">

  <Identity Name="{IdentityName}" Publisher="{Publisher}" Version="{Version}" ProcessorArchitecture="{Arch}" />

  <Properties>
    <DisplayName>Pesée</DisplayName>
    <PublisherDisplayName>{PublisherDisplayName}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Affiche le poids de chaque dossier d'un clic droit dans l'Explorateur.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="fr-FR" />
  </Resources>

  <Applications>
    <Application Id="Pesee" Executable="Pesee.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Pesée"
        Description="Affiche le poids de chaque dossier d'un clic droit dans l'Explorateur."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile ShortName="Pesée" />
      </uap:VisualElements>

      <Extensions>
        <!-- « Analyser la taille » dans le clic droit principal de Windows 11
             (et dans le menu classique sous Windows 10). -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="PeseeAnalyser" Clsid="3CE6D7A1-C30C-4FC1-9A7D-1449787722E9" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="PeseeAnalyser" Clsid="3CE6D7A1-C30C-4FC1-9A7D-1449787722E9" />
            </desktop5:ItemType>
            <!-- « Drive » n'est pas accepté par le Store : sur un disque, la commande est proposée
                 dans le vide du disque ouvert (Directory\Background), pas sur son icône dans « Ce PC ». -->
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>

        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Pesée - menu contextuel">
              <com:Class Id="3CE6D7A1-C30C-4FC1-9A7D-1449787722E9" Path="PeseeMenu.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
